# --- Project Settings ---
APP_MODE=development

# --- Logging ---
# Both default from APP_MODE: dev -> DEBUG/console, prod -> INFO/json.
LOG_LEVEL=DEBUG
LOG_FORMAT=console
# Off by default: stdout is the primary sink (docker log driver rotates it).
# If enabled on the Pi, point it at the external HDD volume, not the SD card.
# LOG_FILE=logs/app.log
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=2

# --- Uploads ---
UPLOAD_MAX_BYTES=20000000
UPLOAD_MAX_ISSUES_IN_RESPONSE=200
UPLOAD_MAX_LOGGED_FAILURES=100

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_USER=pg_user
POSTGRES_PASSWORD=pg_password
POSTGRES_DB=pg_db_name

# --- Vector Database ---
VECTOR_DB_URL=http://localhost:6333
# VECTOR_DB_API_KEY=your_api_key

# --- AI Provider ---
AI_PROVIDER=google
AI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004
AI_API_KEY=your_api_key_here

# --- External Tools ---
PERPLEXITY_API_KEY=your_perplexity_key_here

# --- Security (JWT Auth) ---
SECRET_KEY=your_super_secret_random_string_here #  openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=2